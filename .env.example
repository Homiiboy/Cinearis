# Copy to .env and change the database password before exposing services
POSTGRES_DB=cinearis
POSTGRES_USER=cinearis
POSTGRES_PASSWORD=change-this-to-a-strong-password
CINEARIS_PORT=8088
# 127.0.0.1 is safe by default; set to 0.0.0.0 only for LAN exposure.
CINEARIS_BIND_IP=127.0.0.1
# TMDB API key (required for film and TV series search; anime search uses AniList)
TMDB_API_KEY=

# Optional external Vision AI. If unset, offline OCR-only mode is available.
# Uploaded images are sent to the OpenAI API only when VISION_API_KEY is configured.
VISION_API_KEY=
VISION_MODEL=gpt-4.1-mini

# Phase 5: Jellyfin URL reachable FROM the Cinearis backend container
# Example: http://host.docker.internal:8096 (when Jellyfin runs on the Docker host)
JELLYFIN_URL=
JELLYFIN_API_KEY=
